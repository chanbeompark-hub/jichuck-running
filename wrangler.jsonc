{
  // Cloudflare Workers (정적 사이트 호스팅) 설정
  // 배포:  npx wrangler deploy
  // 로컬:  npx wrangler dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "running-club-1986",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
